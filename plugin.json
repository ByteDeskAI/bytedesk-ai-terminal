{
  "contract": 2,
  "kind": "process",
  "id": "ai-terminal",
  "version": "0.1.1",
  "identity": {
    "displayName": "AI Terminal",
    "description": "Shared, durable coding sessions with host-managed routing and permissions."
  },
  "nav": [
    {
      "id": "ai-terminal",
      "label": "AI Terminal",
      "href": "/ai-terminal",
      "order": 50
    }
  ],
  "panels": [
    {
      "id": "ai-terminal",
      "kind": "ai-terminal",
      "url": "/ai-terminal/ui",
      "module": "/ai-terminal/assets/panel.mjs",
      "documentPaths": [
        "/ai-terminal",
        "/ai-terminal/projects/:projectId",
        "/ai-terminal/sessions/:sessionId"
      ]
    }
  ],
  "scopes": [
    "plugin:ai-terminal"
  ],
  "routes": [
    "/ai-terminal/"
  ],
  "spawn": true,
  "binary": "ai-terminal",
  "socket": "plugin.sock",
  "targets": [
    "gateway"
  ],
  "role": "extension",
  "publisher": {
    "id": "bytedesk",
    "name": "ByteDesk"
  },
  "protocol": {
    "major": 2,
    "required": [
      "http.routes.v1",
      "ui.mount.v1",
      "ui.document-paths.v1",
      "host.workload-auth.v1",
      "coding.sessions.v1"
    ],
    "hooks": [
      "activation.check"
    ]
  },
  "permissions": {
    "subscribe": [
      "event.gateway.coding-sessions.v1.changed"
    ],
    "request": [
      "cmd.gateway.coding-sessions.v1.catalog",
      "cmd.gateway.coding-sessions.v1.create",
      "cmd.gateway.coding-sessions.v1.read",
      "cmd.gateway.coding-sessions.v1.recover",
      "cmd.gateway.coding-sessions.v1.list",
      "cmd.gateway.coding-sessions.v1.prompt",
      "cmd.gateway.coding-sessions.v1.stop",
      "cmd.gateway.coding-sessions.v1.end",
      "cmd.gateway.coding-sessions.v1.complete",
      "cmd.gateway.coding-sessions.v1.new-task",
      "cmd.gateway.coding-sessions.v1.preferences",
      "cmd.gateway.coding-sessions.v1.approve",
      "cmd.gateway.coding-sessions.v1.events",
      "cmd.gateway.coding-sessions.v1.open-surface",
      "cmd.gateway.coding-sessions.v1.preview",
      "cmd.gateway.coding-sessions.v1.preview-read",
      "cmd.gateway.coding-sessions.v1.preview-cancel",
      "cmd.gateway.payloads.v1.create",
      "cmd.gateway.payloads.v1.append",
      "cmd.gateway.payloads.v1.commit",
      "cmd.gateway.payloads.v1.read",
      "cmd.gateway.payloads.v1.revoke"
    ]
  },
  "projectViews": [
    {
      "id": "ai-terminal",
      "label": "AI Terminal",
      "icon": "terminal",
      "order": 50,
      "panelId": "ai-terminal"
    }
  ],
  "capabilities": [
    "process.supervised"
  ]
}
